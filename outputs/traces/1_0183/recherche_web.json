                "end_index": 3290,
                "start_index": 3063,
                "title": "Les collections du département des arts graphiques - 1820 - 1838 Notice des dessins, peintures, émaux et terres cuites émaillées exposés au Musée Royal, dans la Galerie d'Apollon",
                "type": "url_citation",
                "url": "https://arts-graphiques.louvre.fr/detail/expositions/0/imprimer/2765-Notice-des-dessins-peintures-emaux-et-terres-cuites-emaillees-exposes-au-Musee-Royal-dans-la-Galerie-dApollon?utm_source=openai"
              }
